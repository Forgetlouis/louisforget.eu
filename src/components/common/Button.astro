---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  className?: string;
  children: any;
  external?: boolean;
}

const { 
  href = '#', 
  variant = 'primary', 
  size = 'md', 
  className = '',
  children,
  external = false
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center gap-2 font-medium rounded-lg transition-all duration-200';

const variants = {
  primary: 'bg-blue-600 hover:bg-blue-700 text-white shadow-sm hover:shadow-md',
  secondary: 'bg-muted hover:bg-muted/80 text-foreground',
  outline: 'border border-border text-foreground hover:bg-muted',
};

const sizes = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-4 py-2.5 text-base',
  lg: 'px-6 py-3 text-lg',
};

const attrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a href={href} class={`${baseStyles} ${variants[variant]} ${sizes[size]} ${className}`} {...attrs}>
  {children}
</a>
