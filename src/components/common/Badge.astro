---
interface Props {
  variant?: 'default' | 'secondary' | 'outline';
  size?: 'sm' | 'md';
  children: any;
}

const { variant = 'default', size = 'sm', children } = Astro.props;

const baseStyles = 'inline-flex items-center gap-1 rounded-full font-medium transition-colors';

const variants = {
  default: 'bg-muted text-foreground hover:bg-muted/80',
  secondary: 'bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-200',
  outline: 'border border-border text-foreground hover:bg-muted',
};

const sizes = {
  sm: 'px-2.5 py-1 text-xs',
  md: 'px-3 py-1.5 text-sm',
};
---

<span class={`${baseStyles} ${variants[variant]} ${sizes[size]}`}>
  {children}
</span>
