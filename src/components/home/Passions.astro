---
import Section from '@components/common/Section.astro';
import Card from '@components/common/Card.astro';
import passionsData from '@data/passions.json';
---

<Section 
  id="passions" 
  title="Mes passions"
  subtitle="Ce qui m'anime au-delà du code"
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {passionsData.map((passion, index) => (
      <Card className="animate-fade-in" style={`animation-delay: ${index * 150}ms`}>
        <div class="space-y-4">
          <div class="text-5xl">{passion.emoji}</div>
          <div>
            <h3 class="text-2xl font-semibold mb-3">{passion.title}</h3>
            <p class="text-muted-foreground mb-4 leading-relaxed">{passion.description}</p>
            <div class="flex flex-wrap gap-2">
              {passion.highlights.map((highlight) => (
                <span class="inline-block px-3 py-1 bg-muted rounded-full text-sm text-foreground/70">
                  {highlight}
                </span>
              ))}
            </div>
          </div>
        </div>
      </Card>
    ))}
  </div>
</Section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
    opacity: 0;
  }
</style>
