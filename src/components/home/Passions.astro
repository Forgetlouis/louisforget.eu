---
import content from '@data/site-content.json';
import passionsData from '@data/passions.json';

const passions = content.moi;
---

<section id="passions" class="border-t border-[#cbd8dd] px-4 py-20 sm:px-6 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 grid gap-5 lg:grid-cols-[0.55fr_1.45fr]">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-[#527080]">{passions.passionsEyebrow}</p>
      <div>
        <h2 class="max-w-3xl text-3xl font-semibold tracking-tight text-[#101827] sm:text-4xl">{passions.passionsTitle}</h2>
        <p class="mt-4 max-w-2xl text-base leading-7 text-[#52616b]">{passions.passionsDescription}</p>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {passionsData.map((passion, index) => (
        <article class="group min-h-72 rounded-2xl border border-[#cbd8dd] bg-white p-6 shadow-[0_18px_50px_-42px_rgba(15,23,42,0.55)] transition-all duration-300 hover:-translate-y-1 hover:border-[#91a8b1] hover:shadow-[0_22px_55px_-38px_rgba(15,23,42,0.45)] sm:p-8">
          <div class="flex items-start justify-between">
            <span class="grid h-14 w-14 place-items-center rounded-full border border-[#d3dfe3] bg-[#edf4f5] text-3xl" aria-hidden="true">{passion.emoji}</span>
            <span class="font-mono text-[10px] text-[#71858f]">0{index + 1}</span>
          </div>
          <h3 class="mt-10 text-2xl font-semibold tracking-tight text-[#101827]">{passion.title}</h3>
          <p class="mt-3 max-w-xl text-sm leading-7 text-[#52616b]">{passion.description}</p>
          <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 border-t border-[#dde6e9] pt-4">
            {passion.highlights.map((highlight) => (
              <span class="font-mono text-[10px] uppercase tracking-wide text-[#55717d]">{highlight}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
