---
import passionsData from '@data/passions.json';
---

<section id="passions" class="border-t border-border px-4 py-20 sm:px-6 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 grid gap-5 lg:grid-cols-[0.55fr_1.45fr]">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-muted-foreground">Ce qui compte</p>
      <div>
        <h2 class="max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">Mes passions racontent aussi ma manière de travailler.</h2>
        <p class="mt-4 max-w-2xl text-base leading-7 text-muted-foreground">Endurance, préparation, observation et adaptation : les mêmes réflexes guidés dehors sont utiles en engineering.</p>
      </div>
    </div>

    <div class="divide-y divide-border border-y border-border">
      {passionsData.map((passion, index) => (
        <article class="grid gap-5 py-8 sm:grid-cols-[80px_0.75fr_1.25fr] sm:items-start lg:py-10">
          <p class="font-mono text-xs text-muted-foreground">0{index + 1}</p>
          <div>
            <span class="mb-4 block text-3xl" aria-hidden="true">{passion.emoji}</span>
            <h3 class="text-xl font-semibold tracking-tight">{passion.title}</h3>
          </div>
          <div>
            <p class="max-w-xl text-sm leading-7 text-muted-foreground">{passion.description}</p>
            <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
              {passion.highlights.map((highlight) => (
                <span class="font-mono text-[11px] uppercase tracking-wide text-foreground/55">{highlight}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
