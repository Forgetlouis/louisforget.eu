---
import Button from '@components/common/Button.astro';
import { Github, Linkedin, Mail, FileText } from 'lucide-react';
import { withBase } from '@utils/routes';
import content from '@data/site-content.json';

const hero = content.hero;
---

<section class="relative min-h-[calc(100vh-4rem)] overflow-hidden border-b border-[#cbd8dd] bg-[#edf3f5] px-4 pb-16 pt-28 text-[#101827] sm:px-6 lg:px-8 lg:pb-20">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-[8%] top-16 h-72 w-72 rounded-full bg-cyan-400/[0.12] blur-3xl"></div>
    <div class="absolute right-[12%] top-36 h-64 w-64 rounded-full bg-indigo-500/[0.08] blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-6xl">
    <div class="grid min-h-[calc(100vh-12rem)] items-center gap-12 lg:grid-cols-[1.18fr_0.82fr]">
      <div class="max-w-3xl">
        <div class="mb-7 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.18em] text-[#55717d]">
          <span class="h-2 w-2 rounded-full bg-emerald-500 shadow-[0_0_12px_rgba(16,185,129,0.45)]"></span>
          {hero.availability}
        </div>

        <p class="mb-4 text-sm font-medium text-[#55717d]">{hero.specialties}</p>
        <h1 class="max-w-4xl text-5xl font-semibold leading-[0.95] tracking-[-0.055em] sm:text-6xl lg:text-7xl">
          {content.site.name}
        </h1>
        <p class="mt-6 max-w-2xl text-xl leading-8 text-[#52616b] sm:text-2xl">
          {hero.tagline}
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <Button href={withBase('/#experience')} variant="primary" size="lg">
            {hero.primaryCta}
            <span aria-hidden="true">↓</span>
          </Button>
          <Button href={withBase('/moi')} variant="outline" size="lg">
            {hero.secondaryCta}
            <span aria-hidden="true">↗</span>
          </Button>
        </div>

        <div class="mt-10 flex gap-2">
          <a href={content.site.github} target="_blank" rel="noopener noreferrer" class="rounded-full border border-border p-3 transition hover:-translate-y-0.5 hover:border-foreground/30" aria-label="GitHub"><Github size={17} /></a>
          <a href={content.site.linkedin} target="_blank" rel="noopener noreferrer" class="rounded-full border border-border p-3 transition hover:-translate-y-0.5 hover:border-foreground/30" aria-label="LinkedIn"><Linkedin size={17} /></a>
          <a href={`mailto:${content.site.email}`} class="rounded-full border border-border p-3 transition hover:-translate-y-0.5 hover:border-foreground/30" aria-label="Email"><Mail size={17} /></a>
        </div>
      </div>

      <aside class="relative hidden lg:block" aria-label="Photo et informations professionnelles">
        <div class="ml-auto aspect-[4/5] max-h-[620px] max-w-[440px] overflow-hidden rounded-[2rem] border border-[#cbd8dd] bg-white shadow-[0_30px_100px_-50px_rgba(15,23,42,0.35)]">
          <div class="flex h-full flex-col justify-between p-7">
            <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.16em] text-[#71858f]">
              <span>Profile / LF</span>
              <span>49.1° N</span>
            </div>
            <div class="grid aspect-square place-items-center rounded-full border border-[#d3dfe3]">
              <div class="grid h-32 w-32 place-items-center rounded-full border border-dashed border-[#afbdc3] font-mono text-xs text-[#71858f]">{hero.portraitLabel}</div>
            </div>
            <div class="grid grid-cols-2 gap-4 border-t border-[#d3dfe3] pt-5 font-mono text-[11px] text-[#71858f]">
              <span>{hero.profileMetaLeft}</span>
              <span class="text-right">{hero.profileMetaRight}</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    section > div:last-child > div > div:first-child {
      animation: hero-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    aside {
      animation: hero-enter 900ms 120ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
