---
import Section from '@components/common/Section.astro';
import Card from '@components/common/Card.astro';
import philosophyData from '@data/philosophy.json';
import { getIconComponent } from '@utils/icons';

type IconName = 'Zap' | 'Code' | 'Cloud' | 'BarChart3' | 'BookOpen' | 'Users';
---

<Section 
  id="philosophy" 
  title="Ma philosophie d'ingénierie"
  subtitle="Comment je travaille au quotidien"
>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {philosophyData.map((item, index) => {
      const Icon = getIconComponent(item.icon as IconName);
      return (
        <Card className="group animate-fade-in" style={`animation-delay: ${index * 100}ms`}>
          <div class="space-y-4">
            <div class="w-12 h-12 bg-gradient-to-br from-blue-500/20 to-cyan-500/20 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
              <Icon size={24} className="text-blue-600 dark:text-blue-400" />
            </div>
            <div className="space-y-2">
              <h3 className="font-semibold text-lg">{item.title}</h3>
              <p className="text-sm text-muted-foreground leading-relaxed">{item.description}</p>
            </div>
          </div>
        </Card>
      );
    })}
  </div>
</Section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
    opacity: 0;
  }
</style>
