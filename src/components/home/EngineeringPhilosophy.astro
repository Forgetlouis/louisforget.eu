---
import philosophyData from '@data/philosophy.json';
import { getIconComponent } from '@utils/icons';

type IconName = 'Zap' | 'Code' | 'Cloud' | 'BarChart3' | 'BookOpen' | 'Users';
---

<section id="philosophy" class="border-t border-border px-4 py-20 sm:px-6 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 grid gap-5 lg:grid-cols-[0.55fr_1.45fr]">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-muted-foreground">Ma philosophie</p>
      <div>
        <h2 class="max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">Des systèmes plus simples, maintenables et observables.</h2>
        <p class="mt-4 max-w-2xl text-base leading-7 text-muted-foreground">Comment je transforme les contraintes techniques en décisions durables.</p>
      </div>
    </div>

    <div class="grid border-l border-t border-border sm:grid-cols-2 lg:grid-cols-3">
      {philosophyData.map((item, index) => {
        const Icon = getIconComponent(item.icon as IconName);
        return (
          <article class="group min-h-64 border-b border-r border-border p-6 transition-colors duration-300 hover:bg-muted/25 sm:p-8">
            <div class="flex items-start justify-between">
              <Icon size={21} strokeWidth={1.5} className="text-foreground/65" />
              <span class="font-mono text-[10px] text-muted-foreground">0{index + 1}</span>
            </div>
            <h3 class="mt-12 text-lg font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">{item.description}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>
