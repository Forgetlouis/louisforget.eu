---
import { Github, ExternalLink } from 'lucide-react';
import Badge from '@components/common/Badge.astro';

interface Props {
  title: string;
  description: string;
  context: string;
  problem: string;
  solution: string;
  technologies: string[];
  results: string;
  learnings: string;
  github?: string;
  demo?: string;
  status: string;
}

const { 
  title, 
  description, 
  context, 
  problem, 
  solution, 
  technologies, 
  results, 
  learnings,
  github,
  demo,
  status
} = Astro.props;
---

<div class="group border border-border rounded-lg overflow-hidden hover:border-muted-foreground hover:shadow-lg transition-all duration-300 bg-background">
  <!-- Header -->
  <div class="p-6 bg-gradient-to-r from-blue-500/5 to-cyan-500/5 border-b border-border">
    <div class="flex items-start justify-between gap-4 mb-4">
      <div class="flex-1">
        <h3 class="text-xl font-semibold mb-2">{title}</h3>
        <p class="text-muted-foreground text-sm">{description}</p>
      </div>
      <Badge variant={status === 'En production' ? 'default' : 'secondary'}>
        {status}
      </Badge>
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 space-y-6">
    <!-- Context -->
    <div class="grid md:grid-cols-2 gap-6">
      <div>
        <h4 class="font-semibold text-sm text-muted-foreground mb-2 uppercase tracking-wide">Contexte</h4>
        <p class="text-sm leading-relaxed">{context}</p>
      </div>
      <div>
        <h4 class="font-semibold text-sm text-muted-foreground mb-2 uppercase tracking-wide">Problématique</h4>
        <p class="text-sm leading-relaxed">{problem}</p>
      </div>
    </div>

    <!-- Solution -->
    <div class="pt-4 border-t border-border">
      <h4 class="font-semibold text-sm text-muted-foreground mb-2 uppercase tracking-wide">Solution</h4>
      <p class="text-sm leading-relaxed">{solution}</p>
    </div>

    <!-- Results & Learnings -->
    <div class="grid md:grid-cols-2 gap-6 pt-2 border-t border-border">
      <div>
        <h4 class="font-semibold text-sm text-muted-foreground mb-2 uppercase tracking-wide">Résultats</h4>
        <p class="text-sm leading-relaxed text-green-700 dark:text-green-400 font-medium">{results}</p>
      </div>
      <div>
        <h4 class="font-semibold text-sm text-muted-foreground mb-2 uppercase tracking-wide">Enseignements</h4>
        <p class="text-sm leading-relaxed">{learnings}</p>
      </div>
    </div>

    <!-- Technologies -->
    <div class="pt-4 border-t border-border">
      <h4 class="font-semibold text-sm text-muted-foreground mb-3 uppercase tracking-wide">Technologies</h4>
      <div class="flex flex-wrap gap-2">
        {technologies.map((tech) => (
          <Badge variant="outline" size="sm">
            {tech}
          </Badge>
        ))}
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="px-6 py-4 bg-muted/30 border-t border-border flex gap-3">
    {github && (
      <a 
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-medium text-foreground hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
      >
        <Github size={16} />
        Code Source
      </a>
    )}
    {demo && (
      <a 
        href={demo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-medium text-foreground hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
      >
        <ExternalLink size={16} />
        Démo
      </a>
    )}
  </div>
</div>
