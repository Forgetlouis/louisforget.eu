---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navigation from '@components/layout/Navigation.astro';
import Footer from '@components/layout/Footer.astro';
import Section from '@components/common/Section.astro';
import Card from '@components/common/Card.astro';
import Badge from '@components/common/Badge.astro';
import labData from '@data/lab.json';
import { Github, ExternalLink } from 'lucide-react';

const title = 'Lab - Projets d\'Expérimentation';
const description = 'Découvrez mes projets d\'expérimentation et d\'apprentissage en cours';

const statusStyles: Record<string, string> = {
  'En cours': 'bg-[#dbecef] text-[#34746e] border-[#bdd6d3]',
  'Prototype': 'bg-[#ebe8fb] text-[#6257a6] border-[#d1cced]',
  'Expérimentation': 'bg-[#f5ead1] text-[#9a7431] border-[#e3d2a7]',
};
---

<BaseLayout {title} {description}>
  <Navigation />
  <main class="bg-[#edf3f5] pt-20 text-[#101827]">
    <Section id="lab-hero" className="py-16 lg:py-24">
      <div class="max-w-4xl space-y-5">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-[#55717d]">Expérimentations / prototypes</p>
        <h1 class="text-5xl font-semibold leading-[0.98] tracking-[-0.05em] sm:text-6xl">Le Lab</h1>
        <p class="max-w-3xl text-xl leading-8 text-[#52616b]">
          Mes projets d'expérimentation et d'apprentissage. Des essais techniques pour explorer de nouvelles limites et approfondir mes compétences.
        </p>
      </div>
    </Section>

    <Section className="py-0">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {labData.map((project, index) => (
          <Card className="flex flex-col rounded-2xl border-[#cbd8dd] bg-white animate-fade-in shadow-[0_18px_55px_-48px_rgba(15,23,42,0.65)]" style={`animation-delay: ${index * 100}ms`}>
            <!-- Header -->
            <div class="pb-4 border-b border-[#dde6e9]">
              <div class="flex items-start justify-between gap-3 mb-3">
                <h3 class="text-xl font-semibold leading-tight">{project.title}</h3>
                <span class={`whitespace-nowrap rounded-full border px-3 py-1 text-xs font-medium ${statusStyles[project.status] || 'bg-[#edf4f5] text-[#55717d] border-[#d3dfe3]'}`}>
                  {project.status}
                </span>
              </div>
              <p class="text-sm text-[#52616b] leading-relaxed">{project.description}</p>
            </div>

            <!-- Technologies -->
            <div class="py-4 border-b border-[#dde6e9]">
              <div class="text-xs font-semibold text-[#71858f] mb-2 uppercase tracking-wide">Technologies</div>
              <div class="flex flex-wrap gap-2">
                {project.technologies.map((tech) => (
                  <Badge variant="outline" size="sm">
                    {tech}
                  </Badge>
                ))}
              </div>
            </div>

            <!-- Progress Bar -->
            <div class="py-4 border-b border-[#dde6e9]">
              <div class="text-xs font-semibold text-[#71858f] mb-2 uppercase tracking-wide">Progression</div>
              <div class="w-full h-2 bg-[#e4ecef] rounded-full overflow-hidden">
                <div 
                  class="h-full bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full transition-all duration-500"
                  style={`width: ${project.progress}%`}
                ></div>
              </div>
              <div class="text-xs text-[#71858f] mt-2">{project.progress}% complet</div>
            </div>

            <!-- Links -->
            <div class="pt-4 mt-auto flex gap-3">
              {project.github && (
                <a 
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm font-medium text-[#55717d] hover:text-[#101827] transition-colors group"
                >
                  <Github size={16} class="group-hover:scale-110 transition-transform" />
                  Code
                </a>
              )}
            </div>
          </Card>
        ))}
      </div>
    </Section>

    <!-- More Info Section -->
    <Section className="py-12">
      <div class="bg-white border border-[#cbd8dd] rounded-2xl p-8 space-y-4 shadow-[0_18px_55px_-48px_rgba(15,23,42,0.65)]">
        <h3 class="text-lg font-semibold">À propos de cette section</h3>
        <p class="text-[#52616b]">
          Le Lab est un espace d'expérimentation. Certains projets sont en cours d'évolution, 
          d'autres sont des prototypes ou des explorations. L'objectif est d'apprendre continuellement 
          et de partager mon processus d'apprentissage.
        </p>
        <p class="text-[#52616b]">
          Consultez les dépôts GitHub pour plus de détails, code source et documentation.
        </p>
      </div>
    </Section>
  </main>
  <Footer />
</BaseLayout>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
    opacity: 0;
  }
</style>
