---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navigation from '@components/layout/Navigation.astro';
import Footer from '@components/layout/Footer.astro';
import Passions from '@components/home/Passions.astro';
import { withBase } from '@utils/routes';

const title = 'Moi — Louis Forget';
const description = 'Randonnée, vélo, plongée, ingénierie et curiosité technique.';
---

<BaseLayout {title} {description}>
  <Navigation />
  <main class="pt-20">
    <section class="px-4 pb-14 pt-16 sm:px-6 lg:pb-20 lg:pt-24">
      <div class="mx-auto max-w-6xl">
        <p class="mb-5 font-mono text-xs uppercase tracking-[0.22em] text-muted-foreground">Au-delà des systèmes</p>
        <div class="grid gap-10 lg:grid-cols-[1fr_0.75fr] lg:items-end">
          <h1 class="max-w-4xl text-5xl font-semibold leading-[0.98] tracking-[-0.05em] sm:text-6xl">
            L’ingénieur, le sportif, le curieux.
          </h1>
          <p class="max-w-xl text-lg leading-8 text-muted-foreground">
            J’ai besoin de comprendre, de préparer et d’explorer. Ces trois moteurs traversent aussi bien mon travail que mes sorties en montagne, à vélo ou sous l’eau.
          </p>
        </div>
      </div>
    </section>

    <Passions />

    <section class="border-t border-border px-4 py-16 sm:px-6 lg:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-8 lg:grid-cols-[0.7fr_1.3fr]">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-muted-foreground">Ma manière d’avancer</p>
          <div class="grid gap-10 sm:grid-cols-3">
            <div>
              <p class="text-3xl font-semibold">Préparer</p>
              <p class="mt-3 text-sm leading-6 text-muted-foreground">Analyser le contexte, identifier les risques et partir avec un plan réaliste.</p>
            </div>
            <div>
              <p class="text-3xl font-semibold">Tester</p>
              <p class="mt-3 text-sm leading-6 text-muted-foreground">Apprendre par l’expérience, rester mesurable et accepter les ajustements.</p>
            </div>
            <div>
              <p class="text-3xl font-semibold">Partager</p>
              <p class="mt-3 text-sm leading-6 text-muted-foreground">Documenter, transmettre et faire grandir une équipe plutôt qu’une seule solution.</p>
            </div>
          </div>
        </div>
        <div class="mt-14 flex flex-col gap-3 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-muted-foreground">Vous voulez voir ce que j’explore actuellement ?</p>
          <a href={withBase('/lab')} class="inline-flex items-center gap-2 text-sm font-medium border-b border-foreground/30 pb-1 hover:border-foreground">
            Ouvrir le Lab <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
