---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navigation from '@components/layout/Navigation.astro';
import Footer from '@components/layout/Footer.astro';
import Passions from '@components/home/Passions.astro';
import { withBase } from '@utils/routes';
import content from '@data/site-content.json';

const moi = content.moi;
const title = content.seo.moi.title;
const description = content.seo.moi.description;
---

<BaseLayout {title} {description}>
  <Navigation />
  <main class="bg-[#edf3f5] pt-20 text-[#101827]">
    <section class="border-b border-[#cbd8dd] px-4 pb-14 pt-16 sm:px-6 lg:pb-20 lg:pt-24">
      <div class="mx-auto max-w-6xl">
        <p class="mb-5 font-mono text-xs uppercase tracking-[0.22em] text-muted-foreground">{moi.eyebrow}</p>
        <div class="grid gap-10 lg:grid-cols-[1fr_0.75fr] lg:items-end">
          <h1 class="max-w-4xl text-5xl font-semibold leading-[0.98] tracking-[-0.05em] sm:text-6xl">
            {moi.title}
          </h1>
          <p class="max-w-xl text-lg leading-8 text-[#52616b]">
            {moi.intro}
          </p>
        </div>
      </div>
    </section>

    <Passions />

    <section class="border-t border-[#cbd8dd] px-4 py-16 sm:px-6 lg:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="grid gap-8 lg:grid-cols-[0.7fr_1.3fr]">
          <p class="font-mono text-xs uppercase tracking-[0.22em] text-muted-foreground">{moi.methodEyebrow}</p>
          <div class="grid gap-10 sm:grid-cols-3">
            {moi.methods.map((method) => (
              <div>
                <p class="text-3xl font-semibold">{method.title}</p>
                <p class="mt-3 text-sm leading-6 text-[#52616b]">{method.description}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="mt-14 flex flex-col gap-3 border-t border-[#cbd8dd] pt-8 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-muted-foreground">{moi.labPrompt}</p>
          <a href={withBase('/lab')} class="inline-flex items-center gap-2 text-sm font-medium border-b border-foreground/30 pb-1 hover:border-foreground">
            {moi.labCta} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
