  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint src/**/*.{astro,ts,tsx}",
    "lint:fix": "eslint src/**/*.{astro,ts,tsx} --fix",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,json}\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "astro": "^5.0.0",
